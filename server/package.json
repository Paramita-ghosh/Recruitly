    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.3.0",
    "ics": "^3.8.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
